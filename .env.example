# Copy to .env.local for local development. On Vercel, add the same names under
# Project > Settings > Environment Variables. Where to find each value: docs/14-deployment.md

# --- Supabase (required) -------------------------------------------------------------------
# Database: Supabase > Connect > "Transaction pooler" (port 6543). Put your database password in it.
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase > Project Settings > API (or "API Keys")
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Secret / service_role key. Server only. Never put it in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# The same URL and the public anon / publishable key, for live chat in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Optional ------------------------------------------------------------------------------
# Contact address sent to push services with web push requests
VAPID_SUBJECT=mailto:you@example.com
# Fixed push keys (otherwise generated once and stored in the database). Generate: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# TURN server for voice/video calls on strict networks (STUN works for most home Wi-Fi)
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Extra hostnames allowed to open the dev server, comma separated (e.g. a tunnel domain)
# ALLOWED_DEV_ORIGINS=my-tunnel.example.com
