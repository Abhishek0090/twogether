# Port the server listens on (default 3000)
PORT=3000

# Where the SQLite database and uploaded media are stored (default ./data)
# DATA_DIR=./data

# Contact address sent to push services with web push requests
VAPID_SUBJECT=mailto:you@example.com

# Optional TURN server for voice/video calls across strict networks (STUN works for most home Wi-Fi)
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=user
# TURN_CREDENTIAL=secret

# Extra hostnames allowed to open the dev server, comma separated (e.g. a tunnel domain)
# ALLOWED_DEV_ORIGINS=my-tunnel.example.com
